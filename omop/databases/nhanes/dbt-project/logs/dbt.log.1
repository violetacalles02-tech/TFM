        WHEN denominator.num_rows = 0 THEN 0 
        ELSE 1.0*num_violated_rows/denominator.num_rows
    END AS pct_violated_rows,
    denominator.num_rows AS num_denominator_rows
FROM (
    SELECT 
        COUNT(violated_rows.violating_field) AS num_violated_rows
    FROM (
        /*violatedRowsBegin*/
        SELECT 
            'COST.CURRENCY_CONCEPT_ID' AS violating_field, 
            cdmTable.*
        FROM "nhanes_db"."cdm"."cost" cdmTable
            LEFT JOIN 
                "nhanes_db"."vocabularies"."concept" fkTable
                ON cdmTable.CURRENCY_CONCEPT_ID = fkTable.CONCEPT_ID
        WHERE fkTable.CONCEPT_ID IS NULL 
            AND cdmTable.CURRENCY_CONCEPT_ID IS NOT NULL
        /*violatedRowsEnd*/
    ) violated_rows
) violated_row_count,
(
    SELECT 
        COUNT(*) AS num_rows
    FROM "nhanes_db"."cdm"."cost" cdmTable
) denominator
) cte
