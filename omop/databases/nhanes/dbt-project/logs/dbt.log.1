SELECT num_violated_rows,
    CASE
        WHEN denominator.num_rows = 0 THEN 0 
        ELSE 1.0*num_violated_rows/denominator.num_rows
    END AS pct_violated_rows,
    denominator.num_rows AS num_denominator_rows
FROM (
    SELECT 
        COUNT(violated_rows.violating_field) AS num_violated_rows
    FROM (
        /*violatedRowsBegin*/
        SELECT 
            'NOTE.VISIT_OCCURRENCE_ID' AS violating_field, 
            cdmTable.*
        FROM "nhanes_db"."cdm"."note" cdmTable
            LEFT JOIN 
                "nhanes_db"."cdm"."visit_occurrence" fkTable 
                ON cdmTable.VISIT_OCCURRENCE_ID = fkTable.VISIT_OCCURRENCE_ID
        WHERE fkTable.VISIT_OCCURRENCE_ID IS NULL 
            AND cdmTable.VISIT_OCCURRENCE_ID IS NOT NULL
        /*violatedRowsEnd*/
    ) violated_rows
) violated_row_count,
(
    SELECT 
        COUNT(*) AS num_rows
    FROM "nhanes_db"."cdm"."note" cdmTable
) denominator
) cte
